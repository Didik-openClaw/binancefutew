# ===== Mode =====
# paper = harga asli, uang simulasi (MULAI DI SINI) · live = order sungguhan · demo = pasar sintetis tanpa koneksi
MODE=paper
# Venue eksekusi akun Anda: hyperliquid | binance
VENUE=hyperliquid
# Wajib diisi persis seperti ini untuk MODE=live
CONFIRM_LIVE=

# ===== Binance USDⓈ-M Futures (bila VENUE=binance) =====
# Buat API key dengan izin Futures SAJA, tanpa Withdraw, dan batasi IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# live | testnet | demo (demo trading Binance)
BINANCE_ENV=live

# ===== Hyperliquid (bila VENUE=hyperliquid) =====
# Alamat wallet utama (akun yang ditradingkan)
HL_WALLET_ADDRESS=
# Private key API wallet (agent) dari app.hyperliquid.xyz/API — BUKAN private key wallet utama
HL_PRIVATE_KEY=
HL_TESTNET=false

# ===== Strategi & risiko =====
# balanced (Seimbang) | bold (Berani, default) | extreme (Ekstrem)
RISK_PROFILE=bold
PAPER_START_EQUITY=10000
# Porsi modal untuk sleeve strategi (sisanya untuk copy trader)
ALLOC_STRATEGY=0.5
# Koin yang ikut turnamen strategi
UNIVERSE=BTC,ETH,SOL,XRP,DOGE,BNB,SUI,AVAX,LINK,LTC,ADA,HYPE
BENCHMARK=BTC
STRATEGY_INTERVAL=1h
LOOKBACK_WEEKS=12
WALKFORWARD_WEEKS=26

# ===== Copy trading =====
# Alamat Hyperliquid yang selalu disalin (pisahkan koma). Kosongkan untuk hanya memakai hasil scout.
LEADERS=
# Opsional: akun Binance sumber sinyal (API key READ-ONLY) yang ikut disalin
BINANCE_LEADER_API_KEY=
BINANCE_LEADER_API_SECRET=
AUTO_SCOUT=true
# true = playbook mingguan langsung aktif; false = tunggu persetujuan di dashboard
AUTO_APPLY_PLAYBOOK=true
# mirror = ikut semua posisi leader sekarang juga; new-only = hanya posisi yang dibuka setelah mulai menyalin
ENTRY_POLICY=mirror
TICK_SECONDS=10
MIN_ORDER_USD=12
REBALANCE_BAND=0.15
LEADER_STALE_SECONDS=120

# Saringan scout
SCOUT_MIN_ACCOUNT=25000
SCOUT_MAX_TURNOVER=200
SCOUT_MAX_FILLS_PER_DAY=150
SCOUT_MAX_DRAWDOWN=0.45
# Maksimal trader yang dianalisis mendalam per minggu (pencarian berhenti lebih awal bila sudah cukup)
SCOUT_DEEP_DIVE=40

# ===== Dashboard =====
API_HOST=127.0.0.1
API_PORT=8787
# Wajib bila API_HOST bukan 127.0.0.1
DASHBOARD_TOKEN=
