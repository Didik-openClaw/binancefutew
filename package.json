{
  "name": "kairos-copy-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Copy-trade futures platform (Binance USDⓈ-M / Hyperliquid) dengan seleksi strategi & trader mingguan",
  "type": "module",
  "workspaces": [
    "engine",
    "dashboard"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "engine": "npm run start -w engine",
    "demo": "npm run demo -w engine",
    "tournament": "npm run tournament -w engine",
    "hunt": "npm run hunt -w engine",
    "scout": "npm run scout -w engine",
    "demo:snapshot": "npm run demo:snapshot -w engine",
    "dev": "npm run dev -w dashboard",
    "build": "npm run build -w dashboard",
    "build:single": "npm run build:single -w dashboard",
    "test": "npm test -w engine",
    "typecheck": "npm run typecheck -w engine && npm run typecheck -w dashboard",
    "replay": "npm run replay -w engine --"
  }
}
